{
  "expo": {
    "name": "Uğrak",
    "slug": "ugrak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ugrak.app"
    },
    "android": {
      "package": "com.ugrak.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F6FDE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6FDE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Uğrak, yakınındaki mekanları sıralamak için konumunu kullanır. Konumun cihazında kalır, sunucuya gönderilmez."
        }
      ]
    ],
    "scheme": "ugrak",
    "experiments": {
      "typedRoutes": false
    },
    "description": "İstanbul’daki üniversite öğrencilerinin mekan puanlama ve kampanya uygulaması"
  }
}
